+#[cfg(all(test, feature = "replay-benchmark"))]
+#[test]
+#[ignore = "one bounded QB-REPLAY-010 native diagnostic"]
+fn qb010_clip_work_attribution() {
+    let root = std::path::PathBuf::from(std::env::var_os("QB010_DIAGNOSTIC_ROOT").expect("test root"));
+    assert_eq!(root.file_name().and_then(|name| name.to_str()), Some(".chronobreak-replay-benchmark"));
+    let tool = std::path::PathBuf::from(std::env::var_os("QB010_DIAGNOSTIC_FFPROBE").expect("packaged ffprobe"));
+    assert!(tool.is_file());
+    std::thread::sleep(std::time::Duration::from_secs(5));
+    for (index, cell) in ["n", "e", "e", "n", "n", "e"].into_iter().enumerate() {
+        let library = root.join(format!("library-{cell}"));
+        assert!(library.join("games").is_dir() && library.join("clips").is_dir());
+        println!("QB010_CELL {}", serde_json::json!({"ordinal": index, "cell": cell}));
+        let clips = list_clips(&library, "http://diagnostic.invalid", Some(&tool)).expect("prepared clips");
+        assert_eq!(clips.len(), 50);
+        assert!(clips.iter().all(|clip| clip.duration_ms > 0));
+        std::thread::sleep(std::time::Duration::from_secs(1));
+    }
+}

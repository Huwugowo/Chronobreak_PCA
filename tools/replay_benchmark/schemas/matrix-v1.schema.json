{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queueback.local/schemas/replay-benchmark/matrix-v1.schema.json",
  "title": "QueueBack replay benchmark ordered matrix specification v1",
  "description": "Input to matrix.py plan. Cross-entry repetition and observer-pair invariants are enforced by the planner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_id",
    "seed",
    "cooldown_seconds",
    "plan_root",
    "arms",
    "order"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "matrix_id": { "$ref": "#/$defs/identifier" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "cooldown_seconds": { "type": "number", "minimum": 0, "maximum": 86400 },
    "timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
    "plan_root": { "$ref": "#/$defs/absoluteWindowsPath" },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/arm" }
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/orderEntry" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "absoluteWindowsPath": {
      "type": "string",
      "pattern": "^[A-Za-z]:\\\\"
    },
    "observerControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "role"],
      "properties": {
        "group_id": { "$ref": "#/$defs/identifier" },
        "role": { "type": "string", "enum": ["minimal", "full"] }
      }
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observer_profile", "repetitions", "scenario"],
      "allOf": [
        {
          "if": {
            "properties": { "observer_profile": { "const": "minimal" } },
            "required": ["observer_profile", "observer_control"]
          },
          "then": {
            "properties": {
              "observer_control": {
                "properties": { "role": { "const": "minimal" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "observer_profile": { "const": "full" } },
            "required": ["observer_profile", "observer_control"]
          },
          "then": {
            "properties": {
              "observer_control": {
                "properties": { "role": { "const": "full" } }
              }
            }
          }
        },
        {
          "if": { "required": ["observer_control"] },
          "then": {
            "properties": {
              "scenario": {
                "required": ["observer_control"],
                "properties": { "observer_control": { "const": true } }
              }
            }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "observer_profile": { "type": "string", "enum": ["minimal", "full"] },
        "repetitions": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
        "scenario": { "$ref": "#/$defs/scenario" },
        "observer_control": { "$ref": "#/$defs/observerControl" }
      }
    },
    "orderEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arm_id", "trial_id"],
      "properties": {
        "arm_id": { "$ref": "#/$defs/identifier" },
        "trial_id": { "$ref": "#/$defs/identifier" },
        "pair_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fixture_ids"],
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "export" } },
            "required": ["kind"]
          },
          "then": {
            "required": [
              "clip_start_ms",
              "clip_end_ms",
              "expected_duration_ms",
              "expected_video_codec",
              "expected_audio_codec",
              "export_presets"
            ]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "lifecycle" } },
            "required": ["kind"]
          },
          "else": {
            "properties": { "fixture_ids": { "maxItems": 1 } }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": {
          "type": "string",
          "enum": [
            "app_idle",
            "cold_open",
            "warm_open",
            "play_pause",
            "rate",
            "seek",
            "scrub",
            "layout",
            "lifecycle",
            "export"
          ]
        },
        "fixture_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "seek_reason": {
          "type": "string",
          "enum": ["benchmark", "event-jump", "endpoint-edit"]
        },
        "seek_playback_mode": {
          "type": "string",
          "enum": ["playing", "paused"]
        },
        "seed": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "warmup_seconds": { "type": "number", "minimum": 0, "maximum": 3600 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
        "idle_seconds": { "type": "number", "minimum": 0, "maximum": 3600 },
        "target_times_ms": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "rates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "number", "enum": [0.25, 0.5, 1, 2, 4, 8] }
        },
        "request_rate_hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "iterations": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "distance_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["near", "far", "forward", "backward"] }
        },
        "export_presets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["horizontal", "vertical", "discord"] }
        },
        "clip_start_ms": { "type": "integer", "minimum": 0 },
        "clip_end_ms": { "type": "integer", "minimum": 5000 },
        "expected_duration_ms": { "type": "integer", "minimum": 5000, "maximum": 86400000 },
        "duration_tolerance_ms": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "expected_video_codec": { "const": "h264" },
        "expected_audio_codec": { "const": "aac" },
        "music_mode": { "type": "string", "enum": ["none", "built_in"] },
        "gain_mode": { "type": "string", "enum": ["unity", "non_unity"] },
        "built_in_music_filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "music_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["none", "built_in"] }
        },
        "gain_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["unity", "non_unity"] }
        },
        "endpoint_alignment": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["keyframe", "non_keyframe"] }
        },
        "observer_control": { "type": "boolean" }
      }
    }
  }
}

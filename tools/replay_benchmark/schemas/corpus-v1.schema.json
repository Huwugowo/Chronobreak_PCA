{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queueback.local/schemas/replay-benchmark/corpus-v1.schema.json",
  "title": "QueueBack generated replay corpus specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "sentinel_root", "output_root", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "corpus_id": { "$ref": "#/$defs/identifier" },
    "sentinel_root": { "$ref": "#/$defs/absoluteWindowsPath" },
    "output_root": { "$ref": "#/$defs/absoluteWindowsPath" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "alias", "game_timestamp", "source_video", "transform", "backend",
          "expected_video_codec", "expected_audio_codec", "minimum_duration_seconds"
        ],
        "allOf": [
          {
            "if": { "properties": { "transform": { "enum": ["repeat", "hevc"] } } },
            "then": { "required": ["target_duration_seconds"] },
            "else": { "not": { "required": ["target_duration_seconds"] } }
          }
        ],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "alias": { "$ref": "#/$defs/identifier" },
          "game_timestamp": { "type": "string", "pattern": "^\\d+(?:-[1-9]\\d{0,2})?$" },
          "source_video": { "$ref": "#/$defs/absoluteWindowsPath" },
          "transform": { "type": "string", "enum": ["copy", "remux_audio", "repeat", "hevc"] },
          "backend": { "$ref": "#/$defs/identifier" },
          "expected_video_codec": { "type": "string", "enum": ["h264", "hevc"] },
          "expected_audio_codec": { "const": "aac" },
          "minimum_duration_seconds": { "type": "number", "minimum": 1, "maximum": 86400 },
          "target_duration_seconds": { "type": "number", "minimum": 1, "maximum": 86400 },
          "event_interval_seconds": { "type": "number", "minimum": 1, "maximum": 300 },
          "snapshot_interval_seconds": { "type": "number", "minimum": 1, "maximum": 600 }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "absoluteWindowsPath": { "type": "string", "pattern": "^[A-Za-z]:\\\\" }
  }
}

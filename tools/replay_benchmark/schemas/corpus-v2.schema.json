{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://queueback.local/schemas/replay-benchmark/corpus-v2.schema.json",
  "title": "QueueBack generated replay corpus specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "sentinel_root", "output_root", "fixtures"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "corpus_id": { "$ref": "#/$defs/identifier" },
    "sentinel_root": {
      "allOf": [
        { "$ref": "#/$defs/absoluteWindowsPath" },
        { "pattern": "[\\\\/]\\.chronobreak-replay-time$" }
      ]
    },
    "output_root": { "$ref": "#/$defs/absoluteWindowsPath" },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/fixture" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "media_id",
        "alias",
        "game_timestamp",
        "source_video",
        "transform",
        "expected_video_codec",
        "expected_audio_codec",
        "expected_frame_rate",
        "minimum_duration_seconds"
      ],
      "allOf": [
        {
          "if": {
            "required": ["transform"],
            "properties": {
              "transform": { "enum": ["repeat", "normalize", "hevc"] }
            }
          },
          "then": { "required": ["target_duration_seconds"] },
          "else": { "not": { "required": ["target_duration_seconds"] } }
        },
        {
          "if": {
            "required": ["transform"],
            "properties": { "transform": { "const": "normalize" } }
          },
          "then": {
            "properties": { "expected_video_codec": { "const": "h264" } }
          }
        },
        {
          "if": {
            "required": ["transform"],
            "properties": { "transform": { "const": "hevc" } }
          },
          "then": {
            "properties": { "expected_video_codec": { "const": "hevc" } }
          }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "media_id": { "$ref": "#/$defs/mediaId" },
        "alias": { "$ref": "#/$defs/identifier" },
        "game_timestamp": {
          "type": "string",
          "pattern": "^\\d+(?:-[1-9]\\d{0,2})?$"
        },
        "source_video": { "$ref": "#/$defs/absoluteWindowsPath" },
        "transform": {
          "type": "string",
          "enum": ["copy", "remux_audio", "repeat", "normalize", "hevc"]
        },
        "expected_video_codec": { "type": "string", "enum": ["h264", "hevc"] },
        "expected_audio_codec": { "type": "string", "const": "aac" },
        "expected_frame_rate": { "$ref": "#/$defs/positiveRational" },
        "minimum_duration_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 86400
        },
        "target_duration_seconds": { "$ref": "#/$defs/positiveRational" },
        "event_interval_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300,
          "multipleOf": 0.000001
        },
        "snapshot_interval_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 600,
          "multipleOf": 0.000001
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "mediaId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "positiveRational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {
          "type": "string",
          "pattern": "^[1-9]\\d*$",
          "maxLength": 19
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9]\\d*$",
          "maxLength": 20
        }
      }
    },
    "absoluteWindowsPath": {
      "type": "string",
      "minLength": 4,
      "pattern": "^[A-Za-z]:\\\\"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronobreak.local/schemas/feature-list.schema.json",
  "title": "Chronobreak Feature List",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "features"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "Chronobreak"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "P4",
        "P5"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not-started",
        "in-progress",
        "blocked",
        "done"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "draft",
        "ready"
      ]
    },
    "workflow": {
      "type": "string",
      "enum": [
        "direct",
        "adaptive",
        "planned"
      ]
    },
    "verificationStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "automated",
            "manual",
            "benchmark",
            "inspection"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "stage",
        "name",
        "description",
        "priority",
        "area",
        "status",
        "dependencies",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "epic",
            "feature"
          ]
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "user_value": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "differentiation": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "difficulty": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "epic": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "success_criteria"
          ],
          "properties": {
            "id": {},
            "kind": {
              "const": "epic"
            },
            "stage": {
              "const": "draft"
            },
            "name": {},
            "description": {},
            "priority": {},
            "area": {},
            "status": {},
            "parent_id": {},
            "dependencies": {},
            "evidence": {},
            "notes": {},
            "user_value": {},
            "differentiation": {},
            "difficulty": {},
            "success_criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "feature": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "execution",
            "acceptance_criteria",
            "verification"
          ],
          "properties": {
            "id": {},
            "kind": {
              "const": "feature"
            },
            "stage": {},
            "name": {},
            "description": {},
            "priority": {},
            "area": {},
            "status": {},
            "parent_id": {},
            "dependencies": {},
            "evidence": {},
            "notes": {},
            "user_value": {},
            "differentiation": {},
            "difficulty": {},
            "execution": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "workflow",
                "plan"
              ],
              "properties": {
                "workflow": {
                  "$ref": "#/$defs/workflow"
                },
                "plan": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            "acceptance_criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "verification": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/verificationStep"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "ready"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "acceptance_criteria": {
                "minItems": 1
              },
              "verification": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "item": {
      "oneOf": [
        {
          "$ref": "#/$defs/epic"
        },
        {
          "$ref": "#/$defs/feature"
        }
      ]
    }
  }
}

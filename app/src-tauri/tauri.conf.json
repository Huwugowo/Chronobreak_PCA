{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronobreak",
  "version": "0.1.0",
  "identifier": "com.leaguereplay.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chronobreak",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 680,
        "backgroundColor": "#0d0c10",
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:0; media-src 'self' http://127.0.0.1:0; img-src 'self' http://127.0.0.1:0 data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; object-src 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "wix": {
        "upgradeCode": "e18bbdb6-ecc8-5471-8cf1-882ae862f9da"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

exports[`freezes the ordered Viewer executor contract ('settled-memory') 1`] = `
[
  "event:viewer_mounted {"payload":{"duration_ms":240000,"frame_rate_numerator":"60","frame_rate_denominator":"1","has_video_url":true},"meta":{"generation":1,"required":true}}",
  "event:media_canplay {"payload":{},"meta":{"generation":2,"required":true}}",
  "event:first_presented_frame {"payload":{},"meta":{"generation":2,"required":true}}",
